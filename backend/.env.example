# Server
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/superfans

# Auth (generate long random strings for production)
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Storage: local | cloudinary
STORAGE_DRIVER=local
UPLOADS_DIR=uploads

# Filled in later milestones
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
CLOUDINARY_URL=

# Read-only path to original Laravel assets (dev bridge for migrated media)
LEGACY_ASSETS_DIR=

# Growth bot clock (the Laravel `growth:process` scheduler, now inside the API process).
# Unset = on in production, off in development. Set explicitly to override.
GROWTH_BOT=on
