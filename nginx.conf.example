# Superfans — nginx reverse proxy (place in /etc/nginx/sites-available/superfans,
# symlink into sites-enabled, then: nginx -t && systemctl reload nginx).
# Serves the built frontend as static files and proxies the API + media to the Node backend.
# Replace YOUR_DOMAIN and the dist path. Run certbot afterwards for HTTPS.

server {
    listen 80;
    server_name YOUR_DOMAIN www.YOUR_DOMAIN;

    # large uploads (videos)
    client_max_body_size 200M;

    # --- API ---
    location /api/ {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # websockets (chat / livekit signalling if proxied)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # --- media / assets (served by the backend from uploads + legacy-assets) ---
    location /assets/ {
        proxy_pass http://127.0.0.1:5000;
        proxy_set_header Host $host;
        expires 7d;
    }

    # --- frontend SPA (built static files) ---
    root /var/www/superfans/superfans-mern/frontend/dist;
    index index.html;

    # Link-preview crawlers (WhatsApp, Facebook, Twitter, Slack, Discord, Telegram, …) never
    # run this app's JavaScript — they just read whatever meta tags are already in the HTML
    # they fetch. The static index.html below carries none, so every shared link (including a
    # creator's own profile) previewed with no image at all. Those user agents get sent to the
    # backend instead, which fills in the right og:title/og:image per profile (see
    # backend/src/routes/og.routes.ts); every other visitor is untouched and still gets the
    # SPA straight off disk.
    set $is_crawler 0;
    if ($http_user_agent ~* "facebookexternalhit|Facebot|WhatsApp|Twitterbot|LinkedInBot|Slackbot|Discordbot|TelegramBot|SkypeUriPreview|vkShare|Pinterest|redditbot|Applebot") {
        set $is_crawler 1;
    }

    location / {
        # nginx only allows `proxy_pass` itself inside an `if` block — not try_files, not
        # proxy_set_header/proxy_http_version — so those sit here unconditionally; they are
        # simply inert on any request that never reaches proxy_pass below.
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        if ($is_crawler = 1) {
            proxy_pass http://127.0.0.1:5000;
        }
        try_files $uri $uri/ /index.html;   # client-side routing fallback
    }
}
